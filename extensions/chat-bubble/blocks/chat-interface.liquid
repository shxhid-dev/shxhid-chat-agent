{% comment %}
  AI Chat Assistant ("TIA") — app embed block
  v6.0 — Studio redesign: TIA logo mark + wordmark (inline SVG), Lucide icons, neutral palette
    with one accent, list-style empty state, composer with the photo preview inside it.
    All styles live in assets/chat.css; only the "hide until loaded" rule stays inline.
  v5.0 — Display modes (full screen / side popup) and themes, remembered by chat.js.
  v4.1 — Email capture popup removed completely (hard-kill rule lives in chat.css).
{% endcomment %}

{%- capture tia_mark -%}<svg class="tia-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect class="tia-mark-tile" width="24" height="24" rx="7"/><path class="tia-mark-glyph" d="M7.5 7.5h9M12 7.5v9"/><circle class="tia-mark-dot" cx="17.25" cy="16.5" r="1.75"/></svg>{%- endcapture -%}

<style>.shop-ai-reset{display:none}</style>
{{ 'chat.css' | asset_url | stylesheet_tag }}

<div class="shop-ai-reset tia-mode-modal" data-theme="light">
  <div class="shop-ai-floating-group" id="shop-ai-floating-group">
    <button type="button" class="shop-ai-launcher" data-trigger="ask" aria-label="Open TIA, the shop assistant">
      {{ tia_mark }}<span>Ask TIA</span>
    </button>
  </div>

  <div class="shop-ai-backdrop" id="shop-ai-backdrop"></div>

  <div class="shop-ai-modal" id="shop-ai-modal" role="dialog" aria-modal="true" aria-labelledby="shop-ai-title">
    <div class="shop-ai-header">
      <div class="shop-ai-brand">
        {{ tia_mark }}
        <div class="shop-ai-brand-text">
          <h2 class="shop-ai-brand-title" id="shop-ai-title"><span class="tia-sr">TIA</span><svg class="tia-wordmark" viewBox="0 0 30 13" aria-hidden="true" focusable="false"><path d="M1 1.15h9M5.5 1.15V13M14.5 0V13M18.6 13L23.6 1.4 28.6 13M20.5 8.5h6.2" stroke-linejoin="bevel"/></svg></h2>
          <span class="shop-ai-brand-sub">Creative Automation parts assistant</span>
        </div>
      </div>
      <div class="shop-ai-header-actions">
        <button type="button" class="shop-ai-icon-btn shop-ai-mode-btn tia-press" id="shop-ai-mode-btn" aria-label="Switch to side popup" title="Switch layout">
          <svg class="tia-i tia-icon-to-popup" viewBox="0 0 24 24" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M15 3v18"/></svg>
          <svg class="tia-i tia-icon-to-modal" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="M21 3l-7 7"/><path d="M3 21l7-7"/></svg>
        </button>
        <button type="button" class="shop-ai-icon-btn shop-ai-menu-btn tia-press" id="shop-ai-menu-btn" aria-label="More options" aria-haspopup="menu" aria-expanded="false">
          <svg class="tia-i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
        </button>
        <button type="button" class="shop-ai-icon-btn tia-press" id="shop-ai-close-btn" aria-label="Close">
          <svg class="tia-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
    </div>

    <div class="shop-ai-menu-dropdown" id="shop-ai-menu" role="menu" aria-label="Chat options">
      <button type="button" class="shop-ai-menu-item tia-press" role="menuitem" data-action="new"><svg class="tia-i tia-i-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.4 2.6a1 1 0 0 1 3 3L12.4 14.6a2 2 0 0 1-.85.5l-2.87.84a.5.5 0 0 1-.62-.62l.84-2.87a2 2 0 0 1 .5-.85z"/></svg>New chat</button>
      <button type="button" class="shop-ai-menu-item tia-press" role="menuitem" data-action="history"><svg class="tia-i tia-i-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l4 2"/></svg>Previous chats</button>
      <div class="shop-ai-menu-sep" role="separator"></div>
      <div class="shop-ai-menu-label" id="shop-ai-layout-label">Layout</div>
      <div class="shop-ai-segmented" role="group" aria-labelledby="shop-ai-layout-label">
        <button type="button" data-set-mode="modal" aria-pressed="true">Full screen</button>
        <button type="button" data-set-mode="popup" aria-pressed="false">Side panel</button>
      </div>
      <div class="shop-ai-menu-label" id="shop-ai-theme-label">Appearance</div>
      <div class="shop-ai-segmented" role="group" aria-labelledby="shop-ai-theme-label">
        <button type="button" data-set-theme="light" aria-pressed="true">Light</button>
        <button type="button" data-set-theme="dark" aria-pressed="false">Dark</button>
        <button type="button" data-set-theme="system" aria-pressed="false">Auto</button>
      </div>
      <div class="shop-ai-menu-sep" role="separator"></div>
      <button type="button" class="shop-ai-menu-item danger tia-press" role="menuitem" data-action="end"><svg class="tia-i tia-i-sm" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>End chat</button>
    </div>

    <div class="shop-ai-messages" id="shop-ai-messages" aria-live="polite" aria-relevant="additions">
      <div class="shop-ai-suggestions visible" id="shop-ai-suggestions">
        <div class="shop-ai-empty">
          {{ tia_mark }}
          <div class="shop-ai-empty-copy">
            <h3 class="shop-ai-empty-title">Hi, I'm TIA</h3>
            <p class="shop-ai-empty-text">Ask about any part, or send a photo of its nameplate and I'll find it in our catalogue.</p>
          </div>
        </div>
        <div class="shop-ai-sugg-title">Try asking</div>
        <div class="shop-ai-sugg-list">
          <button type="button" class="shop-ai-sugg-item is-photo tia-press" onclick="ShopAIChat.openPhotoPicker()">
            <svg class="tia-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
            <span>Find a part from a photo</span>
            <svg class="tia-i tia-i-sm tia-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </button>
          <button type="button" class="shop-ai-sugg-item tia-press" onclick="ShopAIChat.openAndSend('Show me circuit breakers for industrial applications')">
            <svg class="tia-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg>
            <span>Circuit breakers for industrial use</span>
            <svg class="tia-i tia-i-sm tia-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </button>
          <button type="button" class="shop-ai-sugg-item tia-press" onclick="ShopAIChat.openAndSend('I need pneumatic components for manufacturing')">
            <svg class="tia-i" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 14 4-4"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/></svg>
            <span>Pneumatic components</span>
            <svg class="tia-i tia-i-sm tia-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </button>
          <button type="button" class="shop-ai-sugg-item tia-press" onclick="ShopAIChat.openAndSend('Help me find the right inverter drive')">
            <svg class="tia-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"/></svg>
            <span>Help me pick an inverter drive</span>
            <svg class="tia-i tia-i-sm tia-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </button>
          <button type="button" class="shop-ai-sugg-item tia-press" onclick="ShopAIChat.openAndSend('Do you have SKU: ')">
            <svg class="tia-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><path d="M8 7v10"/><path d="M12 7v10"/><path d="M17 7v10"/></svg>
            <span>Search by SKU or model number</span>
            <svg class="tia-i tia-i-sm tia-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        </div>
      </div>
    </div>

    <div class="shop-ai-input-area">
      <div class="shop-ai-input-wrapper">
        <div class="shop-ai-image-preview" id="shop-ai-image-preview" hidden></div>
        <div class="shop-ai-composer-row">
          <button type="button" class="shop-ai-attach-btn tia-press" id="shop-ai-attach-btn" aria-label="Attach a photo of the part or its nameplate" title="Attach a photo">
            <svg class="tia-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
          </button>
          <input type="file" id="shop-ai-file-input" accept="image/*" hidden>
          <textarea class="shop-ai-textarea" id="shop-ai-input" placeholder="Ask about a part, or attach a photo" rows="1" aria-label="Message TIA" enterkeyhint="send"></textarea>
          <button type="button" class="shop-ai-send-btn" id="shop-ai-send-btn" aria-label="Send">
            <svg class="tia-i" viewBox="0 0 24 24" aria-hidden="true" style="stroke-width:2.25"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg>
          </button>
        </div>
      </div>
      <div class="shop-ai-composer-hint">
        <span><kbd>Enter</kbd> to send · <kbd>Shift</kbd> + <kbd>Enter</kbd> for a new line</span>
        <span class="tia-hint-right">Answers come from our catalogue</span>
      </div>
    </div>

    <div class="shop-ai-history-panel" id="shop-ai-history-panel" aria-label="Previous chats">
      <div class="shop-ai-history-header">
        <button type="button" class="shop-ai-back-btn tia-press" id="shop-ai-back-btn" aria-label="Back to chat"><svg class="tia-i" viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
        <h3>Previous chats</h3>
      </div>
      <div class="shop-ai-history-list" id="shop-ai-history-list"></div>
    </div>
  </div>
</div>

<script>
  (function() {
    var backend = {{ block.settings.backend_url | default: "" | json }};
    var welcome = {{ block.settings.welcome_message | json }};
    var shopDomain = {{ shop.permanent_domain | json }};

    if (backend && backend !== 'https://shxhid-chat-agent-production.up.railway.app') {
      window.shopChatConfig = {
        apiUrl: backend + '/chat',
        leadsUrl: backend + '/leads',
        cartUrl: backend + '/api/cart',
        shopDomain: shopDomain,
        rootUrl: {{ routes.root_url | json }},
        cartPageUrl: {{ routes.cart_url | json }},
        cartAddUrl: {{ routes.cart_add_url | json }},
        shopId: '{{ shop.id }}',
        promptType: 'creativeAutomationAssistant',
        welcomeMessage: welcome,
        emailPopupEnabled: false
      };
    } else {
      window.shopChatConfig = {
        apiUrl: '/apps/shop-chat/chat',
        leadsUrl: '/apps/shop-chat/leads',
        cartUrl: '/apps/shop-chat/api/cart',
        shopDomain: shopDomain,
        rootUrl: {{ routes.root_url | json }},
        cartPageUrl: {{ routes.cart_url | json }},
        cartAddUrl: {{ routes.cart_add_url | json }},
        shopId: '{{ shop.id }}',
        promptType: 'creativeAutomationAssistant',
        welcomeMessage: welcome,
        emailPopupEnabled: false
      };
    }
  })();
</script>

<!-- Email capture popup: permanently disabled.
     Runs before chat.js (which is deferred), so it also covers older chat.js builds. -->
<script>
(function(){
  try { sessionStorage.setItem('shopAiEmailPopupShown', 'true'); } catch (e) {}

  function killEmailPopup(){
    if (window.ShopAIChat) {
      window.ShopAIChat.showEmailPopup = function(){};
    }
    var nodes = document.querySelectorAll('#shop-ai-email-overlay, .shop-ai-email-overlay');
    for (var i = 0; i < nodes.length; i++) {
      if (nodes[i].parentNode) nodes[i].parentNode.removeChild(nodes[i]);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', killEmailPopup);
  } else {
    killEmailPopup();
  }
})();
</script>

<script src="{{ 'chat.js' | asset_url }}" defer></script>

<!-- Mark the Shopify section wrapper so the blur CSS skips it -->
<script>
(function(){
  var el = document.querySelector('.shop-ai-reset');
  if (el) {
    var section = el.closest('.shopify-section') || el.parentElement;
    if (section && section !== document.body) {
      section.classList.add('shop-ai-chat-section');
    }
  }
})();
</script>

<script>
(function(){
  'use strict';

  var BUTTON_HTML =
    '<div class="shop-ai-header-trigger-wrap" id="shop-ai-header-btn-wrap">' +
      '<button class="shop-ai-header-trigger" id="shop-ai-header-btn" aria-label="Ask TIA, the shop assistant" type="button">' +
        '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect class="tia-mark-tile" width="24" height="24" rx="7"/><path class="tia-mark-glyph" d="M7.5 7.5h9M12 7.5v9"/><circle class="tia-mark-dot" cx="17.25" cy="16.5" r="1.75"/></svg>' +
        '<span class="shop-ai-trigger-label">Ask TIA</span>' +
      '</button>' +
    '</div>';

  function injectHeaderButton() {
    if (document.getElementById('shop-ai-header-btn-wrap')) return true;
    var headerIcons = document.querySelector('.header__icons');
    if (headerIcons) { headerIcons.insertAdjacentHTML('afterbegin', BUTTON_HTML); bindBtn(); return true; }
    var headerRight = document.querySelector('header .header__icon, header .site-header__icons, header .header-icons, header .header__buttons, .header__heading-link ~ *');
    if (headerRight && headerRight.parentElement) { headerRight.parentElement.insertAdjacentHTML('afterbegin', BUTTON_HTML); bindBtn(); return true; }
    var headerEl = document.querySelector('header') || document.querySelector('[role="banner"]');
    if (headerEl) {
      var inner = headerEl.querySelector('.header, .header__wrapper, .site-header__wrapper');
      if (inner) { inner.insertAdjacentHTML('beforeend', BUTTON_HTML); } else { headerEl.insertAdjacentHTML('beforeend', BUTTON_HTML); }
      bindBtn(); return true;
    }
    return false;
  }

  function bindBtn() {
    var btn = document.getElementById('shop-ai-header-btn');
    if (!btn) return;
    btn.addEventListener('click', function(e) {
      e.preventDefault(); e.stopPropagation();
      if (window.ShopAIChat && typeof window.ShopAIChat.open === 'function') { window.ShopAIChat.open(); }
      else { document.body.classList.add('shop-ai-open'); }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      if (!injectHeaderButton()) { var tries=0; var iv=setInterval(function(){ tries++; if(injectHeaderButton()||tries>20) clearInterval(iv); },250); }
    });
  } else {
    if (!injectHeaderButton()) { var tries=0; var iv=setInterval(function(){ tries++; if(injectHeaderButton()||tries>20) clearInterval(iv); },250); }
  }
})();
</script>


{% schema %}
{
  "name": "AI Chat Assistant",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "backend_url",
      "label": "Backend API URL",
      "placeholder": "https://your-backend-url.com",
      "info": "Leave empty to use Shopify app proxy (recommended). Only set for custom/staging backend URL."
    },
    {
      "type": "text",
      "id": "chat_title",
      "label": "Chat Title",
      "default": "AI Assistant"
    },
    {
      "type": "text",
      "id": "welcome_message",
      "label": "Welcome Message",
      "default": "Hi! How can I help you today?"
    }
  ]
}
{% endschema %}
