{% comment %}
  AI Chat Assistant ("TIA") — app embed block
  v5.0 — Redesign: all styles moved to assets/chat.css (light/dark themes, modal or side-popup
    layout, both remembered in localStorage by chat.js). Header says "TIA"; a greeting sits in
    the chat body. Only the "hide until chat.css loads" rule stays inline.
  v4.1 — Email capture popup removed completely (hard-kill rule now lives in chat.css).
{% endcomment %}

<style>.shop-ai-reset{display:none}</style>
{{ 'chat.css' | asset_url | stylesheet_tag }}

<div class="shop-ai-reset tia-mode-modal" data-theme="light" aria-hidden="false">
  <div class="shop-ai-floating-group" id="shop-ai-floating-group">
    <button type="button" class="shop-ai-launcher" data-trigger="ask" aria-label="Open TIA, the shop assistant">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><path d="M8 9h8M8 13h5"/></svg>
    </button>
  </div>

  <div class="shop-ai-backdrop" id="shop-ai-backdrop"></div>

  <div class="shop-ai-modal" id="shop-ai-modal" role="dialog" aria-modal="true" aria-labelledby="shop-ai-title">
    <div class="shop-ai-header">
      <div class="shop-ai-brand">
        <span class="shop-ai-brand-orb" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5l1.9 5.6 5.6 1.9-5.6 1.9L12 17.5l-1.9-5.6-5.6-1.9 5.6-1.9L12 2.5zM18.5 15l.9 2.6 2.6.9-2.6.9-.9 2.6-.9-2.6-2.6-.9 2.6-.9.9-2.6z"/></svg>
        </span>
        <div class="shop-ai-brand-text">
          <h3 class="shop-ai-brand-title" id="shop-ai-title">TIA</h3>
          <span class="shop-ai-brand-sub"><i class="shop-ai-status-dot" aria-hidden="true"></i>Technical assistant</span>
        </div>
      </div>
      <div class="shop-ai-header-actions">
        <button type="button" class="shop-ai-icon-btn shop-ai-mode-btn" id="shop-ai-mode-btn" aria-label="Switch to side popup" title="Switch layout">
          <svg class="tia-icon-popup" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><rect x="12" y="11" width="7" height="8" rx="1.5" fill="currentColor" stroke="none"/></svg>
          <svg class="tia-icon-modal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
        </button>
        <button type="button" class="shop-ai-icon-btn shop-ai-menu-btn" id="shop-ai-menu-btn" aria-label="Menu" aria-haspopup="true">
          <div class="shop-ai-3dot-icon"><span></span><span></span><span></span></div>
        </button>
        <button type="button" class="shop-ai-icon-btn" id="shop-ai-close-btn" aria-label="Close">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
    </div>

    <div class="shop-ai-menu-dropdown" id="shop-ai-menu" role="menu">
      <button type="button" class="shop-ai-menu-item" data-action="new"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg> New chat</button>
      <button type="button" class="shop-ai-menu-item" data-action="history"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/></svg> Previous chats</button>
      <div class="shop-ai-menu-sep"></div>
      <div class="shop-ai-menu-label">Layout</div>
      <div class="shop-ai-segmented" role="group" aria-label="Layout">
        <button type="button" data-set-mode="modal" aria-pressed="true">Full screen</button>
        <button type="button" data-set-mode="popup" aria-pressed="false">Side popup</button>
      </div>
      <div class="shop-ai-menu-label">Appearance</div>
      <div class="shop-ai-segmented" role="group" aria-label="Appearance">
        <button type="button" data-set-theme="light" aria-pressed="true">Light</button>
        <button type="button" data-set-theme="dark" aria-pressed="false">Dark</button>
        <button type="button" data-set-theme="system" aria-pressed="false">Auto</button>
      </div>
      <div class="shop-ai-menu-sep"></div>
      <button type="button" class="shop-ai-menu-item danger" data-action="end"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg> End chat</button>
    </div>

    <div class="shop-ai-messages" id="shop-ai-messages" aria-live="polite">
      <div class="shop-ai-suggestions visible" id="shop-ai-suggestions">
        <div class="shop-ai-greeting">
          <div class="shop-ai-greeting-bubble">Hi, I'm <strong>TIA</strong> 👋 Ask me about any part — or send a photo of its nameplate and I'll find it.</div>
        </div>
        <div class="shop-ai-sugg-title">Try asking</div>
        <div class="shop-ai-sugg-list">
          <button type="button" class="shop-ai-sugg-item is-photo" onclick="ShopAIChat.openPhotoPicker()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg> Find a part from a photo</button>
          <button type="button" class="shop-ai-sugg-item" onclick="ShopAIChat.openAndSend('Show me circuit breakers for industrial applications')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg> Circuit breakers for industrial use</button>
          <button type="button" class="shop-ai-sugg-item" onclick="ShopAIChat.openAndSend('I need pneumatic components for manufacturing')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg> Pneumatic components</button>
          <button type="button" class="shop-ai-sugg-item" onclick="ShopAIChat.openAndSend('Help me find the right inverter drive')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg> Help me pick an inverter drive</button>
          <button type="button" class="shop-ai-sugg-item" onclick="ShopAIChat.openAndSend('Do you have SKU: ')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M7 8h10M7 12h10M7 16h6"/></svg> Search by SKU or model number</button>
        </div>
      </div>
    </div>

    <div class="shop-ai-input-area">
      <div class="shop-ai-image-preview" id="shop-ai-image-preview" hidden></div>
      <div class="shop-ai-input-wrapper">
        <button type="button" class="shop-ai-attach-btn" id="shop-ai-attach-btn" aria-label="Send a photo of the part or its nameplate" title="Send a photo of the part or nameplate">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
        </button>
        <input type="file" id="shop-ai-file-input" accept="image/*" hidden>
        <textarea class="shop-ai-textarea" id="shop-ai-input" placeholder="Ask me anything..." rows="1" aria-label="Message TIA"></textarea>
        <button type="button" class="shop-ai-send-btn" id="shop-ai-send-btn" aria-label="Send"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5"/><path d="M5 12l7-7 7 7"/></svg></button>
      </div>
      <div class="shop-ai-disclaimer">TIA answers from our catalogue — please confirm critical specs with our team.</div>
    </div>

    <div class="shop-ai-history-panel" id="shop-ai-history-panel">
      <div class="shop-ai-history-header">
        <button type="button" class="shop-ai-back-btn" id="shop-ai-back-btn" aria-label="Back"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15,18 9,12 15,6"/></svg></button>
        <h3>Previous chats</h3>
      </div>
      <div class="shop-ai-history-list" id="shop-ai-history-list"></div>
    </div>
  </div>
</div>

<script>
  (function() {
    var backend = {{ block.settings.backend_url | default: "" | json }};
    var welcome = {{ block.settings.welcome_message | json }};
    var shopDomain = {{ shop.permanent_domain | json }};

    if (backend && backend !== 'https://shxhid-chat-agent-production.up.railway.app') {
      window.shopChatConfig = {
        apiUrl: backend + '/chat',
        leadsUrl: backend + '/leads',
        cartUrl: backend + '/api/cart',
        shopDomain: shopDomain,
        rootUrl: {{ routes.root_url | json }},
        cartPageUrl: {{ routes.cart_url | json }},
        cartAddUrl: {{ routes.cart_add_url | json }},
        shopId: '{{ shop.id }}',
        promptType: 'creativeAutomationAssistant',
        welcomeMessage: welcome,
        emailPopupEnabled: false
      };
    } else {
      window.shopChatConfig = {
        apiUrl: '/apps/shop-chat/chat',
        leadsUrl: '/apps/shop-chat/leads',
        cartUrl: '/apps/shop-chat/api/cart',
        shopDomain: shopDomain,
        rootUrl: {{ routes.root_url | json }},
        cartPageUrl: {{ routes.cart_url | json }},
        cartAddUrl: {{ routes.cart_add_url | json }},
        shopId: '{{ shop.id }}',
        promptType: 'creativeAutomationAssistant',
        welcomeMessage: welcome,
        emailPopupEnabled: false
      };
    }
  })();
</script>

<!-- Email capture popup: permanently disabled.
     Runs before chat.js (which is deferred), so it also covers older chat.js builds. -->
<script>
(function(){
  try { sessionStorage.setItem('shopAiEmailPopupShown', 'true'); } catch (e) {}

  function killEmailPopup(){
    if (window.ShopAIChat) {
      window.ShopAIChat.showEmailPopup = function(){};
    }
    var nodes = document.querySelectorAll('#shop-ai-email-overlay, .shop-ai-email-overlay');
    for (var i = 0; i < nodes.length; i++) {
      if (nodes[i].parentNode) nodes[i].parentNode.removeChild(nodes[i]);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', killEmailPopup);
  } else {
    killEmailPopup();
  }
})();
</script>

<script src="{{ 'chat.js' | asset_url }}" defer></script>

<!-- Mark the Shopify section wrapper so the blur CSS skips it -->
<script>
(function(){
  var el = document.querySelector('.shop-ai-reset');
  if (el) {
    var section = el.closest('.shopify-section') || el.parentElement;
    if (section && section !== document.body) {
      section.classList.add('shop-ai-chat-section');
    }
  }
})();
</script>

<script>
(function(){
  'use strict';

  var BUTTON_HTML =
    '<div class="shop-ai-header-trigger-wrap" id="shop-ai-header-btn-wrap">' +
      '<button class="shop-ai-header-trigger" id="shop-ai-header-btn" aria-label="Ask AI Assistant" type="button">' +
        '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L13.5 8.5L20 10L13.5 11.5L12 18L10.5 11.5L4 10L10.5 8.5L12 2Z"/></svg>' +
        '<span class="shop-ai-trigger-label">Ask AI</span>' +
      '</button>' +
    '</div>';

  function injectHeaderButton() {
    if (document.getElementById('shop-ai-header-btn-wrap')) return true;
    var headerIcons = document.querySelector('.header__icons');
    if (headerIcons) { headerIcons.insertAdjacentHTML('afterbegin', BUTTON_HTML); bindBtn(); return true; }
    var headerRight = document.querySelector('header .header__icon, header .site-header__icons, header .header-icons, header .header__buttons, .header__heading-link ~ *');
    if (headerRight && headerRight.parentElement) { headerRight.parentElement.insertAdjacentHTML('afterbegin', BUTTON_HTML); bindBtn(); return true; }
    var headerEl = document.querySelector('header') || document.querySelector('[role="banner"]');
    if (headerEl) {
      var inner = headerEl.querySelector('.header, .header__wrapper, .site-header__wrapper');
      if (inner) { inner.insertAdjacentHTML('beforeend', BUTTON_HTML); } else { headerEl.insertAdjacentHTML('beforeend', BUTTON_HTML); }
      bindBtn(); return true;
    }
    return false;
  }

  function bindBtn() {
    var btn = document.getElementById('shop-ai-header-btn');
    if (!btn) return;
    btn.addEventListener('click', function(e) {
      e.preventDefault(); e.stopPropagation();
      if (window.ShopAIChat && typeof window.ShopAIChat.open === 'function') { window.ShopAIChat.open(); }
      else { document.body.classList.add('shop-ai-open'); }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      if (!injectHeaderButton()) { var tries=0; var iv=setInterval(function(){ tries++; if(injectHeaderButton()||tries>20) clearInterval(iv); },250); }
    });
  } else {
    if (!injectHeaderButton()) { var tries=0; var iv=setInterval(function(){ tries++; if(injectHeaderButton()||tries>20) clearInterval(iv); },250); }
  }
})();
</script>


{% schema %}
{
  "name": "AI Chat Assistant",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "backend_url",
      "label": "Backend API URL",
      "placeholder": "https://your-backend-url.com",
      "info": "Leave empty to use Shopify app proxy (recommended). Only set for custom/staging backend URL."
    },
    {
      "type": "text",
      "id": "chat_title",
      "label": "Chat Title",
      "default": "AI Assistant"
    },
    {
      "type": "text",
      "id": "welcome_message",
      "label": "Welcome Message",
      "default": "Hi! How can I help you today?"
    }
  ]
}
{% endschema %}
